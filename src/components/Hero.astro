---
/**
 * Hero.astro
 *
 * Optimizado para LCP: la imagen se sirve como WebP con srcset, se marca
 * `loading="eager"` + `fetchpriority="high"` (nunca lazy en el above the fold,
 * es el error más común que hunde el LCP) y el texto no espera a ninguna
 * fuente web porque usamos el stack del sistema.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@components/Icon.astro';
import Button from '@components/Button.astro';

interface Props {
  kicker?: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Calidad WebP. Súbela si la imagen tiene detalle fino o degradados largos */
  imageQuality?: number;
  /**
   * Lema de marca rasterizado, colocado a la derecha del titular.
   *
   * Va como <img> propio y no incrustado en `image` porque el fondo se recorta
   * con `object-cover` y el recorte cambia con cada viewport: el texto acabaría
   * cortado o pisando el titular. Así el tamaño es determinista, la imagen
   * queda por encima del degradado de contraste (no debajo, que es lo que
   * apagaba el texto) y se puede ocultar donde no hay sitio.
   *
   * Solo se muestra a partir de 1280 px: por debajo, el titular ocupa el ancho
   * disponible. El texto del lema debe repetirse en `claimAlt` (WCAG 1.1.1).
   */
  claimImage?: ImageMetadata;
  claimAlt?: string;
  bullets?: readonly string[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  /** h1 en la home y en landings; h2 si la página ya tiene otro h1 */
  as?: 'h1' | 'h2';
}

const {
  kicker,
  title,
  subtitle,
  image,
  imageAlt,
  imageQuality = 72,
  claimImage,
  claimAlt = '',
  bullets = [],
  primaryCta = { label: 'Pedir presupuesto gratis', href: '/contacto' },
  secondaryCta,
  as: Heading = 'h1',
}: Props = Astro.props;

/**
 * Nunca pedimos anchos mayores que el original: escalar hacia arriba solo añade
 * peso y difumina la imagen. Añadimos el ancho real si el original se queda por
 * debajo del último tramo, para no perder nitidez en pantallas retina.
 */
const candidateWidths = [640, 960, 1280, 1600, 2000].filter((w) => w <= image.width);
const imageWidths =
  candidateWidths.length === 0
    ? [image.width]
    : candidateWidths.at(-1)! < image.width && image.width < 2000
      ? [...candidateWidths, image.width]
      : candidateWidths;
---

<section class="relative isolate overflow-hidden bg-brand-900">
  <Image
    src={image}
    alt={imageAlt}
    widths={imageWidths}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    format="webp"
    quality={imageQuality}
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <!-- Capa de contraste: garantiza ratio AA del texto sobre la fotografía -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950/95 via-brand-950/85 to-brand-900/55"
    aria-hidden="true"
  >
  </div>

  <div class="container-page py-20 sm:py-24 lg:py-32">
    <div class="max-w-2xl">
      {
        kicker && (
          <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold text-accent-300 ring-1 ring-white/20">
            <Icon name="shield" size={16} />
            {kicker}
          </p>
        )
      }
      <Heading class="text-4xl text-white sm:text-5xl lg:text-6xl">{title}</Heading>
      <p class="mt-5 text-lg text-brand-100 sm:text-xl">{subtitle}</p>

      {
        bullets.length > 0 && (
          <ul class="mt-7 grid gap-2.5 sm:grid-cols-2">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-2.5 text-brand-50">
                <Icon name="check" size={20} class="mt-1 shrink-0 text-accent-300" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={primaryCta.href} size="lg">
          {primaryCta.label}
          <Icon name="arrow-right" size={20} />
        </Button>
        {
          secondaryCta && (
            <Button
              href={secondaryCta.href}
              variant="outline-inverse"
              size="lg"
            >
              {secondaryCta.label}
            </Button>
          )
        }
      </div>
    </div>
  </div>
  {
    claimImage && (
      <Image
        src={claimImage}
        alt={claimAlt}
        width={500}
        height={260}
        densities={[2]}
        loading="eager"
        fetchpriority="low"
        format="webp"
        quality={85}
        class="pointer-events-none mx-auto -mt-4 mb-10 w-64 sm:w-72 xl:absolute xl:top-1/2 xl:right-10 xl:mb-0 xl:w-[30rem] xl:-translate-y-1/2 2xl:right-20"
      />
    )
  }
</section>
