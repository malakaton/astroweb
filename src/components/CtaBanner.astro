---
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import { BUSINESS, telHref } from '@config';

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = '¿Hablamos de tu reforma?',
  description = 'Visita técnica gratuita en Madrid y presupuesto cerrado por partidas en 48-72 horas. Sin compromiso y sin letra pequeña.',
  ctaLabel = 'Pedir presupuesto gratis',
  ctaHref = '/contacto',
} = Astro.props;
---

<section class="bg-brand-900" aria-labelledby="cta-title">
  <div class="container-page py-14 lg:py-16">
    <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 id="cta-title" class="text-3xl text-white sm:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-brand-100">{description}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
        <Button href={ctaHref} size="lg">
          {ctaLabel}
          <Icon name="arrow-right" size={20} />
        </Button>
        <Button
          href={telHref}
          variant="outline"
          size="lg"
          class="border-white/70 bg-transparent text-white hover:bg-white/10 hover:text-white"
        >
          <Icon name="phone" size={20} />
          {BUSINESS.phoneHuman}
        </Button>
      </div>
    </div>
  </div>
</section>
