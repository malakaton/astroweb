---
import Icon from '@components/Icon.astro';
import type { IconName } from '@lib/icons';

interface Step {
  title: string;
  description: string;
  icon: IconName;
}

interface Props {
  steps: readonly Step[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((step, index) => (
      <li class="relative flex flex-col rounded-[var(--radius-card)] border border-brand-100 bg-white p-6 shadow-[var(--shadow-card)]">
        <div class="flex items-center gap-3">
          <span
            class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-brand-900 text-white"
            aria-hidden="true"
          >
            <Icon name={step.icon} size={22} />
          </span>
          <span class="text-sm font-bold tracking-[0.14em] text-accent-700 uppercase">
            Paso {index + 1}
          </span>
        </div>
        <h3 class="mt-4 text-lg">{step.title}</h3>
        <p class="mt-2 text-[0.975rem] text-muted">{step.description}</p>
      </li>
    ))
  }
</ol>
