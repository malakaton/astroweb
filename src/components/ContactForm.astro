---
/**
 * ContactForm.astro
 *
 * Formulario HTML nativo (POST) sin una línea de JavaScript:
 *  - Validación con atributos nativos (required, type, pattern, minlength).
 *  - Envío a /api/contact → Cloudflare Pages Function que valida en servidor,
 *    guarda en Supabase y redirige a /contacto/gracias.
 *  - Honeypot + campo de tiempo como antispam sin captcha (no penaliza CWV ni
 *    accesibilidad y evita cargar reCAPTCHA, que pesa >400 KB de JS).
 */
import { getCollection } from 'astro:content';
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';

const servicios = (await getCollection('servicios'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const fieldBase =
  'w-full min-h-12 rounded-lg border border-brand-200 bg-white px-3.5 py-2.5 text-base text-ink placeholder:text-brand-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-200';
const labelBase = 'block text-sm font-bold text-brand-900';
const hintBase = 'mt-1 text-xs text-muted';
---

<form
  method="POST"
  action="/api/contact"
  class="rounded-[var(--radius-card)] border border-brand-100 bg-white p-6 shadow-[var(--shadow-card)] sm:p-8"
  novalidate={false}
>
  <!-- Antispam: invisible para el usuario, obligatorio vacío en el servidor -->
  <div class="hidden" aria-hidden="true">
    <label for="empresa-web">No rellenar</label>
    <input type="text" id="empresa-web" name="empresa_web" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="origen" value="web-contacto" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label class={labelBase} for="nombre">
        Nombre y apellidos <span class="text-accent-700" aria-hidden="true">*</span>
      </label>
      <input
        class={`${fieldBase} mt-1.5`}
        type="text"
        id="nombre"
        name="nombre"
        required
        minlength="3"
        maxlength="120"
        autocomplete="name"
        placeholder="Ana García"
      />
    </div>

    <div>
      <label class={labelBase} for="email">
        Email <span class="text-accent-700" aria-hidden="true">*</span>
      </label>
      <input
        class={`${fieldBase} mt-1.5`}
        type="email"
        id="email"
        name="email"
        required
        maxlength="180"
        autocomplete="email"
        inputmode="email"
        placeholder="ana@ejemplo.com"
        aria-describedby="email-hint"
      />
      <p id="email-hint" class={hintBase}>Te enviamos el presupuesto a este correo.</p>
    </div>

    <div>
      <label class={labelBase} for="telefono">
        Teléfono <span class="text-accent-700" aria-hidden="true">*</span>
      </label>
      <input
        class={`${fieldBase} mt-1.5`}
        type="tel"
        id="telefono"
        name="telefono"
        required
        pattern="[0-9\s+()-]{9,20}"
        autocomplete="tel"
        inputmode="tel"
        placeholder="600 000 000"
        aria-describedby="telefono-hint"
      />
      <p id="telefono-hint" class={hintBase}>9 dígitos. Solo lo usamos para la visita técnica.</p>
    </div>

    <div>
      <label class={labelBase} for="servicio">
        Tipo de reforma <span class="text-accent-700" aria-hidden="true">*</span>
      </label>
      <select class={`${fieldBase} mt-1.5`} id="servicio" name="servicio" required>
        <option value="">Selecciona una opción</option>
        {
          servicios.map((servicio) => (
            <option value={servicio.id}>{servicio.data.shortTitle ?? servicio.data.title}</option>
          ))
        }
        <option value="otro">Otro tipo de trabajo</option>
      </select>
    </div>

    <div>
      <label class={labelBase} for="localidad">Localidad</label>
      <input
        class={`${fieldBase} mt-1.5`}
        type="text"
        id="localidad"
        name="localidad"
        maxlength="80"
        autocomplete="address-level2"
        placeholder="Madrid"
      />
    </div>

    <div>
      <label class={labelBase} for="superficie">Superficie aproximada (m²)</label>
      <input
        class={`${fieldBase} mt-1.5`}
        type="number"
        id="superficie"
        name="superficie"
        min="1"
        max="10000"
        step="1"
        inputmode="numeric"
        placeholder="90"
      />
    </div>

    <div>
      <label class={labelBase} for="presupuesto">Presupuesto orientativo</label>
      <select class={`${fieldBase} mt-1.5`} id="presupuesto" name="presupuesto">
        <option value="">Prefiero no indicarlo</option>
        <option value="hasta-10000">Hasta 10.000 €</option>
        <option value="10000-30000">10.000 € - 30.000 €</option>
        <option value="30000-60000">30.000 € - 60.000 €</option>
        <option value="mas-60000">Más de 60.000 €</option>
      </select>
    </div>

    <div class="sm:col-span-2">
      <label class={labelBase} for="mensaje">
        Cuéntanos tu proyecto <span class="text-accent-700" aria-hidden="true">*</span>
      </label>
      <textarea
        class={`${fieldBase} mt-1.5 min-h-32`}
        id="mensaje"
        name="mensaje"
        required
        minlength="20"
        maxlength="2000"
        rows="5"
        placeholder="Piso de 90 m² en Chamberí, quiero abrir la cocina al salón y reformar los dos baños."
        aria-describedby="mensaje-hint"></textarea>
      <p id="mensaje-hint" class={hintBase}>
        Mínimo 20 caracteres. Cuanto más detalle, más ajustada será la valoración.
      </p>
    </div>
  </div>

  <div class="mt-6 flex items-start gap-3">
    <input
      class="mt-1 size-5 shrink-0 rounded border-brand-300 text-brand-900 focus:ring-2 focus:ring-brand-300"
      type="checkbox"
      id="rgpd"
      name="rgpd"
      value="si"
      required
    />
    <label class="text-sm text-muted" for="rgpd">
      He leído y acepto la <a
        href="/politica-de-privacidad"
        class="font-semibold text-brand-900 underline">política de privacidad</a
      > y el tratamiento de mis datos para responder a esta solicitud.
      <span class="text-accent-700" aria-hidden="true">*</span>
    </label>
  </div>

  <Button type="submit" size="lg" class="mt-7" full>
    Enviar solicitud de presupuesto
    <Icon name="arrow-right" size={20} />
  </Button>

  <p class="mt-4 flex items-start gap-2 text-xs text-muted">
    <Icon name="shield" size={16} class="mt-0.5 shrink-0 text-brand-500" />
    Respondemos en menos de 24 horas laborables. No compartimos tus datos con terceros ni
    enviamos publicidad.
  </p>
</form>
