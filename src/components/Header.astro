---
/**
 * Header.astro
 *
 * El menú móvil usa <details>/<summary> nativos: obtenemos apertura/cierre,
 * soporte de teclado y estado anunciado por lectores de pantalla con 0 KB de
 * JavaScript. Es la razón por la que la web no envía ningún script al cliente.
 */
import Logo from '@components/Logo.astro';
import Icon from '@components/Icon.astro';
import { BUSINESS, NAV, telHref } from '@config';
import { normalizePath } from '@lib/seo';

const current = normalizePath(Astro.url.pathname);

function isActive(href: string): boolean {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(`${href}/`);
}

const linkBase =
  'block rounded-lg px-3 py-2 text-[0.975rem] font-semibold transition-colors duration-150';
---

<header class="sticky top-0 z-50 border-b border-brand-100 bg-white/95 backdrop-blur-sm">
  <div class="container-page flex h-18 items-center justify-between gap-4 py-3">
    <!-- Sin aria-label: el nombre accesible lo da el texto visible del logo
         (WCAG 2.5.3 Label in Name) -->
    <a href="/" class="rounded-lg">
      <Logo />
    </a>

    <!-- Navegación de escritorio -->
    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  linkBase,
                  isActive(item.href)
                    ? 'bg-brand-50 text-brand-900 underline decoration-accent-600 decoration-2 underline-offset-8'
                    : 'text-brand-800 hover:bg-brand-50 hover:text-brand-900',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={telHref}
        class="inline-flex min-h-11 items-center gap-2 rounded-lg px-3 font-bold text-brand-900 hover:bg-brand-50"
      >
        <Icon name="phone" size={18} />
        <span>{BUSINESS.phoneHuman}</span>
      </a>
      <a
        href="/contacto"
        class="inline-flex min-h-11 items-center rounded-lg bg-accent-700 px-5 font-semibold text-white transition-colors hover:bg-accent-800"
        >Presupuesto gratis</a
      >
    </div>

    <!-- Navegación móvil: sin JS -->
    <details class="group relative lg:hidden">
      <summary
        class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-2 rounded-lg border border-brand-200 px-3 font-semibold text-brand-900 [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Abrir menú de navegación</span>
        <Icon name="menu" size={22} class="group-open:hidden" />
        <Icon name="close" size={22} class="hidden group-open:block" />
        <span aria-hidden="true" class="text-sm">Menú</span>
      </summary>
      <nav
        aria-label="Navegación principal"
        class="absolute right-0 z-50 mt-3 w-[min(20rem,calc(100vw-2.5rem))] rounded-xl border border-brand-100 bg-white p-3 shadow-[var(--shadow-lift)]"
      >
        <ul class="flex flex-col gap-1">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    linkBase,
                    'min-h-11 content-center',
                    isActive(item.href)
                      ? 'bg-brand-50 text-brand-900'
                      : 'text-brand-800 hover:bg-brand-50',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 flex flex-col gap-2 border-t border-brand-100 pt-3">
          <a
            href={telHref}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg px-3 font-bold text-brand-900 hover:bg-brand-50"
          >
            <Icon name="phone" size={18} />
            {BUSINESS.phoneHuman}
          </a>
          <a
            href="/contacto"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-accent-700 px-5 font-semibold text-white hover:bg-accent-800"
            >Pedir presupuesto gratis</a
          >
        </div>
      </nav>
    </details>
  </div>
</header>
