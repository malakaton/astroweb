---
/**
 * ServiceCard.astro — tarjeta de servicio.
 * El enlace envuelve solo el título y se expande con `stretched-link` para que
 * toda la tarjeta sea clicable sin anidar contenido dentro del <a> (mejor para
 * lectores de pantalla: un único enlace con texto descriptivo).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@components/Icon.astro';
import type { IconName } from '@lib/icons';
import { EUR } from '@lib/seo';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  /** URL string (Supabase Storage) o ImageMetadata (asset local) */
  image: string | ImageMetadata;
  imageAlt: string;
  icon: IconName;
  priceFrom?: number | null;
  priceUnit?: string;
  duration?: string | null;
  /** La primera fila de tarjetas puede cargarse sin lazy si está cerca del viewport */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const {
  href,
  title,
  excerpt,
  image,
  imageAlt,
  icon,
  priceFrom,
  priceUnit = 'proyecto',
  duration,
  eager = false,
  headingLevel: Heading = 'h3',
} = Astro.props;
---

<article
  class="group relative flex w-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-brand-100 bg-white shadow-[var(--shadow-card)] transition-shadow duration-300 hover:shadow-[var(--shadow-lift)] focus-within:shadow-[var(--shadow-lift)]"
>
  <div class="relative aspect-3/2 overflow-hidden bg-brand-100">
    {typeof image === 'string' ? (
      <img
        src={image}
        alt={imageAlt}
        width={800}
        height={533}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        class="size-full object-cover transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:scale-[1.04]"
      />
    ) : (
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        format="webp"
        quality={74}
        class="size-full object-cover transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:scale-[1.04]"
      />
    )}
    <span
      class="absolute bottom-3 left-3 flex size-11 items-center justify-center rounded-lg bg-white/95 text-brand-900 shadow-sm"
      aria-hidden="true"
    >
      <Icon name={icon} size={22} />
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <Heading class="text-xl">
      <a href={href} class="stretched-link rounded group-hover:text-brand-700">{title}</a>
    </Heading>
    <p class="mt-2.5 flex-1 text-[0.975rem] text-muted">{excerpt}</p>

    <dl class="mt-4 flex flex-wrap gap-x-5 gap-y-1 border-t border-brand-100 pt-4 text-sm">
      {
        priceFrom && (
          <div class="flex items-baseline gap-1.5">
            <dt class="text-muted">Desde</dt>
            <dd class="font-bold text-brand-900">
              {EUR.format(priceFrom)}
              <span class="font-normal text-muted">/{priceUnit}</span>
            </dd>
          </div>
        )
      }
      {
        duration && (
          <div class="flex items-baseline gap-1.5">
            <dt class="text-muted">Plazo</dt>
            <dd class="font-semibold text-brand-900">{duration}</dd>
          </div>
        )
      }
    </dl>
  </div>
</article>
