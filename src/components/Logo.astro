---
import { Image } from 'astro:assets';
import logoMark from '@assets/logo-grupo-s-valles.png';
import { SITE } from '@config';

interface Props {
  /** En el footer el logo va sobre fondo oscuro: cambia el color del claim */
  tone?: 'dark' | 'light';
  class?: string;
}

const { tone = 'dark', class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <!-- Recorte del logotipo real (logo_reforma.jpg): ya contiene el wordmark,
       por eso el nombre no se repite como texto. El alt aporta el nombre
       accesible al enlace que envuelve el logo. -->
  <Image
    src={logoMark}
    alt={SITE.name}
    width={176}
    height={44}
    densities={[2]}
    loading="eager"
    fetchpriority="high"
    class="h-11 w-auto shrink-0 rounded-md"
  />
  <span
    class:list={[
      'hidden text-[0.7rem] font-semibold tracking-[0.18em] uppercase sm:block',
      tone === 'dark' ? 'text-accent-700' : 'text-accent-300',
    ]}
  >
    Reformas integrales
  </span>
</span>
