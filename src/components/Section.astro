---
/**
 * Section.astro — envoltorio semántico de sección con cabecera opcional.
 * Mantiene la jerarquía de encabezados coherente (h2 por defecto, configurable)
 * y homogeneiza el ritmo vertical de toda la web.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  /** Nivel del encabezado: mantener el orden correcto es requisito WCAG 1.3.1 */
  headingLevel?: 'h1' | 'h2' | 'h3';
  tone?: 'white' | 'muted' | 'brand';
  align?: 'left' | 'center';
  spacing?: 'sm' | 'md' | 'lg';
  class?: string;
  /** Renderiza <section> como <div> si la sección no aporta región propia */
  as?: 'section' | 'div';
}

const {
  id,
  eyebrow,
  title,
  description,
  headingLevel = 'h2',
  tone = 'white',
  align = 'left',
  spacing = 'lg',
  class: className = '',
  as: Tag = 'section',
} = Astro.props;

const Heading = headingLevel;

const tones: Record<NonNullable<Props['tone']>, string> = {
  white: 'bg-white text-ink',
  muted: 'bg-brand-50 text-ink',
  brand: 'bg-brand-900 text-brand-50',
};

const spacings: Record<NonNullable<Props['spacing']>, string> = {
  sm: 'py-10 sm:py-12',
  md: 'py-14 sm:py-16',
  lg: 'py-16 sm:py-20 lg:py-24',
};

const headingId = id ? `${id}-title` : undefined;
---

<Tag
  id={id}
  class:list={[tones[tone], spacings[spacing], className]}
  aria-labelledby={title && headingId ? headingId : undefined}
>
  <div class="container-page">
    {
      (eyebrow || title || description) && (
        <header class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
          {eyebrow && (
            <p
              class:list={[
                'mb-3 text-sm font-bold tracking-[0.14em] uppercase',
                tone === 'brand' ? 'text-accent-300' : 'text-accent-700',
              ]}
            >
              {eyebrow}
            </p>
          )}
          {title && (
            <Heading
              id={headingId}
              class:list={[
                'text-3xl sm:text-4xl lg:text-[2.75rem]',
                tone === 'brand' && 'text-white',
              ]}
            >
              {title}
            </Heading>
          )}
          {description && (
            <p
              class:list={[
                'mt-4 text-lg',
                tone === 'brand' ? 'text-brand-100' : 'text-muted',
              ]}
            >
              {description}
            </p>
          )}
        </header>
      )
    }
    <div class:list={[(eyebrow || title || description) && 'mt-10 sm:mt-12']}>
      <slot />
    </div>
  </div>
</Tag>
