---
export const prerender = false;

import AdminLayout from '@layouts/AdminLayout.astro';
import { createAdminClient, getSupabaseEnv } from '@lib/admin-auth';

const env = getSupabaseEnv(Astro.locals);
const supabase = createAdminClient(env, Astro.cookies);

// Cargar servicios para el desplegable
const { data: servicios } = await supabase
  .from('servicios')
  .select('slug, title, short_title')
  .order('order', { ascending: true });

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  // 1. Subir la imagen al Storage
  const file = form.get('cover') as File;
  let coverUrl = '';

  if (file && file.size > 0) {
    const slug = (form.get('slug') as string)?.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
    const ext = file.name.split('.').pop() || 'webp';
    const path = `proyectos/${slug}/cover.${ext}`;

    const { error: uploadError } = await supabase.storage
      .from('imagenes')
      .upload(path, file, {
        contentType: file.type,
        upsert: true,
      });

    if (uploadError) {
      error = `Error al subir la imagen: ${uploadError.message}`;
    } else {
      const { data: urlData } = supabase.storage.from('imagenes').getPublicUrl(path);
      coverUrl = urlData.publicUrl;
    }
  }

  if (!error) {
    // 2. Insertar el proyecto en la tabla
    const highlights = (form.get('highlights') as string)
      ?.split('\n')
      .map((h) => h.trim())
      .filter(Boolean) ?? [];

    const projectData = {
      slug: (form.get('slug') as string)?.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-'),
      title: (form.get('title') as string)?.trim(),
      description: (form.get('description') as string)?.trim(),
      excerpt: (form.get('excerpt') as string)?.trim(),
      cover_url: coverUrl || null,
      cover_alt: (form.get('cover_alt') as string)?.trim(),
      servicio_slug: (form.get('servicio_slug') as string) || null,
      location: (form.get('location') as string)?.trim(),
      year: Number(form.get('year')) || new Date().getFullYear(),
      surface: Number(form.get('surface')) || 0,
      duration: (form.get('duration') as string)?.trim(),
      budget_range: (form.get('budget_range') as string)?.trim() || null,
      highlights,
      testimonial: null,
      featured: form.get('featured') === 'on',
      draft: form.get('draft') === 'on',
      order: Number(form.get('order')) || 99,
      body_md: (form.get('body_md') as string)?.trim() || null,
    };

    const { error: insertError } = await supabase.from('proyectos').insert(projectData);

    if (insertError) {
      error = `Error al guardar: ${insertError.message}`;
    } else {
      return Astro.redirect('/admin');
    }
  }
}
---

<AdminLayout title="Nuevo proyecto">
  {error && (
    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      {error}
    </div>
  )}

  <form method="POST" enctype="multipart/form-data" class="max-w-3xl space-y-6">
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="title">
          Título del proyecto *
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          maxlength="70"
          placeholder="Reforma integral de ático en Chamberí"
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5"
        />
      </div>

      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="slug">
          Slug (URL) *
        </label>
        <input
          type="text"
          id="slug"
          name="slug"
          required
          maxlength="80"
          placeholder="atico-chamberi"
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5"
        />
        <p class="mt-1 text-xs text-muted">Se usará en la URL: /proyectos/atico-chamberi</p>
      </div>

      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="servicio_slug">
          Servicio relacionado
        </label>
        <select id="servicio_slug" name="servicio_slug" class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5">
          <option value="">Seleccionar...</option>
          {servicios?.map((s) => (
            <option value={s.slug}>{s.short_title || s.title}</option>
          ))}
        </select>
      </div>

      <div class="sm:col-span-2">
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="description">
          Meta description (SEO) *
        </label>
        <input
          type="text"
          id="description"
          name="description"
          required
          minlength="70"
          maxlength="158"
          placeholder="Reforma integral de un ático de 96 m² en Chamberí con apertura de cocina..."
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5"
        />
        <p class="mt-1 text-xs text-muted">70-158 caracteres. Aparece en Google.</p>
      </div>

      <div class="sm:col-span-2">
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="excerpt">
          Resumen corto *
        </label>
        <textarea
          id="excerpt"
          name="excerpt"
          required
          maxlength="220"
          rows="2"
          placeholder="Vivienda de 1962 sin reformar. Se abrió la cocina al salón..."
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5"
        ></textarea>
      </div>

      <!-- Imagen -->
      <div class="sm:col-span-2">
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="cover">
          Foto de portada *
        </label>
        <input
          type="file"
          id="cover"
          name="cover"
          accept="image/webp,image/jpeg,image/png"
          required
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-900 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white"
        />
        <p class="mt-1 text-xs text-muted">WebP recomendado. Máximo 5 MB. Relación 3:2 (1600×1067 px ideal).</p>
      </div>

      <div class="sm:col-span-2">
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="cover_alt">
          Texto alternativo de la foto *
        </label>
        <input
          type="text"
          id="cover_alt"
          name="cover_alt"
          required
          minlength="10"
          placeholder="Salón de ático reformado en Chamberí con acceso a terraza"
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5"
        />
      </div>

      <!-- Datos técnicos -->
      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="location">Localización *</label>
        <input type="text" id="location" name="location" required placeholder="Chamberí, Madrid" class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5" />
      </div>

      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="year">Año *</label>
        <input type="number" id="year" name="year" required min="2000" max="2100" value={new Date().getFullYear()} class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5" />
      </div>

      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="surface">Superficie (m²) *</label>
        <input type="number" id="surface" name="surface" required min="1" placeholder="96" class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5" />
      </div>

      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="duration">Duración *</label>
        <input type="text" id="duration" name="duration" required placeholder="10 semanas" class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5" />
      </div>

      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="budget_range">Presupuesto orientativo</label>
        <input type="text" id="budget_range" name="budget_range" placeholder="68.000 € - 74.000 €" class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5" />
      </div>

      <div>
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="order">Orden</label>
        <input type="number" id="order" name="order" value="99" min="1" class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5" />
      </div>

      <div class="sm:col-span-2">
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="highlights">
          Claves de la intervención (una por línea, mín. 2)
        </label>
        <textarea
          id="highlights"
          name="highlights"
          rows="4"
          placeholder="Apertura de muro de carga con refuerzo metálico&#10;Segundo baño ganado en el hueco del pasillo&#10;Suelo radiante eléctrico en baños"
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5"
        ></textarea>
      </div>

      <div class="sm:col-span-2">
        <label class="mb-1.5 block text-sm font-bold text-brand-900" for="body_md">
          Descripción detallada (Markdown)
        </label>
        <textarea
          id="body_md"
          name="body_md"
          rows="10"
          placeholder="## Punto de partida&#10;&#10;Un ático de 1962 que conservaba...&#10;&#10;## Intervención&#10;&#10;Se eliminó el tabique..."
          class="w-full rounded-lg border border-brand-200 px-3.5 py-2.5 font-mono text-sm"
        ></textarea>
        <p class="mt-1 text-xs text-muted">Puedes usar títulos (## ), negritas (**texto**) y listas (- item).</p>
      </div>

      <!-- Opciones -->
      <div class="sm:col-span-2 flex gap-6">
        <label class="flex items-center gap-2 text-sm font-semibold text-brand-900">
          <input type="checkbox" name="featured" class="size-5 rounded border-brand-300" />
          Destacado (aparece en la home)
        </label>
        <label class="flex items-center gap-2 text-sm font-semibold text-brand-900">
          <input type="checkbox" name="draft" class="size-5 rounded border-brand-300" />
          Borrador (no publicar aún)
        </label>
      </div>
    </div>

    <div class="flex gap-3 border-t border-brand-100 pt-6">
      <button
        type="submit"
        class="inline-flex min-h-12 items-center gap-2 rounded-lg bg-accent-700 px-6 font-semibold text-white hover:bg-accent-800"
      >
        💾 Guardar y publicar
      </button>
      <a
        href="/admin"
        class="inline-flex min-h-12 items-center rounded-lg border-2 border-brand-200 px-5 font-semibold text-brand-800 hover:bg-brand-50"
      >
        Cancelar
      </a>
    </div>
  </form>
</AdminLayout>
