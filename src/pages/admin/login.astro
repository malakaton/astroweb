---
export const prerender = false;

import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = import.meta.env.SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.SUPABASE_ANON_KEY;

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = (form.get('email') as string)?.trim();
  const password = form.get('password') as string;

  if (!email || !password) {
    error = 'Introduce email y contraseña.';
  } else {
    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      auth: { flowType: 'pkce', autoRefreshToken: false, detectSessionInUrl: false, persistSession: false },
    });

    const { data, error: authError } = await supabase.auth.signInWithPassword({ email, password });

    if (authError || !data.session) {
      error = 'Email o contraseña incorrectos.';
    } else {
      // Guardar tokens en cookies httpOnly seguras
      Astro.cookies.set('sb-access-token', data.session.access_token, {
        path: '/admin',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 7,
      });
      Astro.cookies.set('sb-refresh-token', data.session.refresh_token!, {
        path: '/admin',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 30,
      });

      return Astro.redirect('/admin');
    }
  }
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel de administración | Login</title>
  <style>
    * { margin: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 1.5rem;
      font-family: system-ui, -apple-system, sans-serif;
      background: #f1f6f9;
      color: #14181b;
    }
    .card {
      width: 100%;
      max-width: 24rem;
      background: white;
      padding: 2.5rem 2rem;
      border-radius: 1rem;
      border: 1px solid #dceaf2;
      box-shadow: 0 4px 24px -8px rgb(15 42 63 / 0.12);
    }
    h1 { font-size: 1.5rem; color: #0f2a3f; margin-bottom: 0.25rem; }
    .subtitle { font-size: 0.9rem; color: #4b5563; margin-bottom: 1.5rem; }
    label { display: block; font-size: 0.875rem; font-weight: 600; color: #0f2a3f; margin-bottom: 0.35rem; }
    input {
      width: 100%;
      min-height: 2.75rem;
      padding: 0.6rem 0.85rem;
      border: 1px solid #b9d5e5;
      border-radius: 0.5rem;
      font-size: 1rem;
      margin-bottom: 1rem;
      transition: border-color 0.15s;
    }
    input:focus { outline: none; border-color: #356f92; box-shadow: 0 0 0 3px rgb(53 111 146 / 0.15); }
    button {
      width: 100%;
      min-height: 2.75rem;
      border: none;
      border-radius: 0.5rem;
      background: #a9490a;
      color: white;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    button:hover { background: #8a3d0d; }
    .error {
      background: #fef2f2;
      border: 1px solid #fca5a5;
      color: #991b1b;
      padding: 0.6rem 0.85rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
    .logo { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.75rem; }
    .logo svg { width: 2.25rem; height: 2.25rem; }
    .logo span { font-size: 1.1rem; font-weight: 800; color: #0f2a3f; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">
      <svg viewBox="0 0 36 36" fill="none">
        <rect width="36" height="36" rx="9" fill="#0f2a3f"/>
        <path d="M8 20.5 18 11l10 9.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14.5 26v-5.5h7V26" stroke="#ed7014" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Panel admin</span>
    </div>

    <h1>Iniciar sesión</h1>
    <p class="subtitle">Accede al panel para gestionar proyectos y contenido.</p>

    {error && <div class="error">{error}</div>}

    <form method="POST">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autocomplete="email" placeholder="admin@reformasarana.es" />

      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••" />

      <button type="submit">Entrar</button>
    </form>
  </div>
</body>
</html>
