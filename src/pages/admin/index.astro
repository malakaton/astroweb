---
export const prerender = false;

import AdminLayout from '@layouts/AdminLayout.astro';
import { createAdminClient } from '@lib/admin-auth';

const supabase = createAdminClient(Astro.cookies);

const { data: proyectos, error } = await supabase
  .from('proyectos')
  .select('slug, title, location, year, surface, duration, featured, draft, cover_url, updated_at')
  .order('order', { ascending: true });

const items = proyectos ?? [];
---

<AdminLayout title="Proyectos">
  <div class="mb-6 flex items-center justify-between">
    <p class="text-muted">{items.length} proyectos</p>
    <a
      href="/admin/proyectos/nuevo"
      class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-accent-700 px-5 font-semibold text-white hover:bg-accent-800"
    >
      + Nuevo proyecto
    </a>
  </div>

  {error && (
    <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-800">
      Error al cargar los proyectos: {error.message}
    </div>
  )}

  <div class="overflow-x-auto rounded-[var(--radius-card)] border border-brand-100 bg-white shadow-[var(--shadow-card)]">
    <table class="w-full text-left text-sm">
      <thead class="bg-brand-50 text-xs uppercase text-brand-700">
        <tr>
          <th class="px-4 py-3">Proyecto</th>
          <th class="px-4 py-3">Localización</th>
          <th class="px-4 py-3">Año</th>
          <th class="px-4 py-3">m²</th>
          <th class="px-4 py-3">Estado</th>
          <th class="px-4 py-3">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-100">
        {items.map((p) => (
          <tr class="hover:bg-brand-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                {p.cover_url && (
                  <img
                    src={p.cover_url}
                    alt=""
                    width={48}
                    height={32}
                    class="size-12 rounded-lg object-cover"
                  />
                )}
                <span class="font-semibold text-brand-900">{p.title}</span>
              </div>
            </td>
            <td class="px-4 py-3 text-muted">{p.location}</td>
            <td class="px-4 py-3">{p.year}</td>
            <td class="px-4 py-3">{p.surface}</td>
            <td class="px-4 py-3">
              {p.draft ? (
                <span class="rounded-full bg-yellow-100 px-2.5 py-1 text-xs font-semibold text-yellow-800">Borrador</span>
              ) : (
                <span class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-800">Publicado</span>
              )}
            </td>
            <td class="px-4 py-3">
              <a
                href={`/admin/proyectos/${p.slug}/editar`}
                class="rounded-lg px-3 py-1.5 text-sm font-semibold text-brand-800 hover:bg-brand-100"
              >
                Editar
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {items.length === 0 && !error && (
    <div class="mt-8 text-center">
      <p class="text-lg text-muted">Aún no hay proyectos.</p>
      <a href="/admin/proyectos/nuevo" class="mt-3 inline-block font-semibold text-accent-700 hover:underline">
        Crear el primero →
      </a>
    </div>
  )}
</AdminLayout>
