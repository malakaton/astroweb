---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Icon from '@components/Icon.astro';
import Button from '@components/Button.astro';
import ProjectCard from '@components/ProjectCard.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { canonicalUrl, formatDateEs } from '@lib/seo';
import { SITE } from '@config';
import type { Crumb, JsonLdNode } from '@lib/schema';
import { ID } from '@lib/schema';

export const getStaticPaths = (async () => {
  const proyectos = await getCollection('proyectos', ({ data }) => !data.draft);
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { proyecto } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);
const servicio = await getEntry(data.servicio);

const otrosProyectos = (await getCollection('proyectos'))
  .filter((p) => !p.data.draft && p.id !== proyecto.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const otrosConServicio = await Promise.all(
  otrosProyectos.map(async (p) => ({ proyecto: p, servicioRef: await getEntry(p.data.servicio) })),
);

const crumbs: Crumb[] = [
  { name: 'Proyectos', href: '/proyectos' },
  { name: data.title, href: `/proyectos/${proyecto.id}` },
];

/**
 * CreativeWork + reseña: describe la obra ejecutada y, si el cliente dejó
 * testimonio, lo asocia al negocio como Review (con autor real, nunca inventado).
 */
const schemaNodes: JsonLdNode[] = [
  {
    '@type': 'CreativeWork',
    '@id': `${canonicalUrl(`/proyectos/${proyecto.id}`)}#obra`,
    name: data.title,
    description: data.description,
    creator: { '@id': ID.business },
    dateCreated: `${data.year}`,
    locationCreated: { '@type': 'Place', name: data.location },
    about: servicio ? { '@id': ID.service(servicio.id) } : undefined,
    inLanguage: SITE.lang,
  },
];

if (data.testimonial) {
  schemaNodes.push({
    '@type': 'Review',
    '@id': `${canonicalUrl(`/proyectos/${proyecto.id}`)}#review`,
    itemReviewed: { '@id': ID.business },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: data.testimonial.rating,
      bestRating: 5,
      worstRating: 1,
    },
    author: { '@type': 'Person', name: data.testimonial.author },
    reviewBody: data.testimonial.quote,
  });
}

const ficha = [
  { label: 'Localización', value: data.location },
  { label: 'Año', value: `${data.year}` },
  { label: 'Superficie', value: `${data.surface} m²` },
  { label: 'Duración', value: data.duration },
  ...(data.budgetRange ? [{ label: 'Presupuesto', value: data.budgetRange }] : []),
  ...(servicio ? [{ label: 'Servicio', value: servicio.data.shortTitle ?? servicio.data.title }] : []),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  crumbs={crumbs}
  image="/og/og-proyectos.jpg"
  imageAlt={data.coverAlt}
  ogType="article"
  pageType="ItemPage"
  modifiedTime={data.updatedAt.toISOString()}
  schemaNodes={schemaNodes}
>
  <article>
    <div class="container-page py-10 lg:py-14">
      <div class="max-w-3xl">
        <p class="text-sm font-bold tracking-[0.14em] text-accent-700 uppercase">
          {data.location} · {data.year}
        </p>
        <h1 class="mt-3 text-4xl sm:text-5xl">{data.title}</h1>
        <p class="mt-5 text-lg text-muted">{data.excerpt}</p>
      </div>

      <figure class="mt-8 overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-lift)]">
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1280px) 1200px, 96vw"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          format="webp"
          quality={76}
          class="aspect-3/2 size-full object-cover"
        />
        <figcaption class="bg-brand-900 px-5 py-3 text-sm text-brand-100">
          {data.coverAlt}
        </figcaption>
      </figure>

      <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div>
          <div class="rich-text">
            <Content />
          </div>

          <h2 class="mt-10 text-2xl">Claves de la intervención</h2>
          <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {
              data.highlights.map((highlight) => (
                <li class="flex items-start gap-2.5 rounded-lg bg-brand-50 p-3.5">
                  <Icon name="check-circle" size={20} class="mt-0.5 shrink-0 text-accent-600" />
                  <span class="text-[0.975rem] text-brand-900">{highlight}</span>
                </li>
              ))
            }
          </ul>

          {
            data.testimonial && (
              <figure class="mt-10 rounded-[var(--radius-card)] border-l-4 border-accent-500 bg-brand-50 p-6">
                <blockquote class="text-lg text-brand-900 italic">
                  <p>«{data.testimonial.quote}»</p>
                </blockquote>
                <figcaption class="mt-4 text-sm font-semibold text-brand-800">
                  {data.testimonial.author}
                  {data.testimonial.role && (
                    <span class="font-normal text-muted"> · {data.testimonial.role}</span>
                  )}
                </figcaption>
              </figure>
            )
          }
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Ficha técnica del proyecto">
          <div class="rounded-[var(--radius-card)] border border-brand-100 bg-white p-6 shadow-[var(--shadow-card)]">
            <h2 class="text-xl">Ficha técnica</h2>
            <dl class="mt-4 space-y-3 text-sm">
              {
                ficha.map((item) => (
                  <div class="flex items-baseline justify-between gap-3 border-b border-brand-100 pb-3 last:border-0 last:pb-0">
                    <dt class="text-muted">{item.label}</dt>
                    <dd class="text-right font-bold text-brand-900">{item.value}</dd>
                  </div>
                ))
              }
            </dl>

            {
              servicio && (
                <Button href={`/servicios/${servicio.id}`} variant="outline" class="mt-6" full>
                  Ver servicio
                  <Icon name="arrow-right" size={18} />
                </Button>
              )
            }
            <Button href="/contacto" class="mt-3" full>Quiero algo parecido</Button>
            <p class="mt-3 text-xs text-muted">
              Ficha actualizada en <time datetime={data.updatedAt.toISOString().slice(0, 10)}>
                {formatDateEs(data.updatedAt)}
              </time>
            </p>
          </div>
        </aside>
      </div>
    </div>

    <Section tone="muted" title="Otros proyectos" spacing="md">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          otrosConServicio.map(({ proyecto: otro, servicioRef }) => (
            <li class="flex">
              <ProjectCard
                href={`/proyectos/${otro.id}`}
                title={otro.data.title}
                excerpt={otro.data.excerpt}
                image={otro.data.cover}
                imageAlt={otro.data.coverAlt}
                location={otro.data.location}
                year={otro.data.year}
                surface={otro.data.surface}
                duration={otro.data.duration}
                serviceLabel={servicioRef?.data.shortTitle ?? servicioRef?.data.title}
              />
            </li>
          ))
        }
      </ul>
    </Section>
  </article>

  <CtaBanner />
</BaseLayout>
