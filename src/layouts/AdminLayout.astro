---
/**
 * AdminLayout.astro — layout para todas las páginas del panel.
 * Incluye sidebar mínimo y cierra sesión.
 */
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = (Astro.locals as any).user;
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} | Panel admin</title>
</head>
<body class="flex min-h-dvh bg-brand-50">
  <!-- Sidebar -->
  <aside class="hidden w-64 flex-col border-r border-brand-100 bg-white p-5 md:flex">
    <a href="/admin" class="mb-8 flex items-center gap-2 text-lg font-extrabold text-brand-900">
      <svg width="28" height="28" viewBox="0 0 36 36" fill="none" aria-hidden="true">
        <rect width="36" height="36" rx="9" fill="#0f2a3f"></rect>
        <path d="M8 20.5 18 11l10 9.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M14.5 26v-5.5h7V26" stroke="#ed7014" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      Panel
    </a>

    <nav class="flex flex-1 flex-col gap-1">
      <a href="/admin" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-brand-800 hover:bg-brand-50">
        📋 Proyectos
      </a>
      <a href="/admin/proyectos/nuevo" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-brand-800 hover:bg-brand-50">
        ➕ Nuevo proyecto
      </a>
    </nav>

    <div class="mt-auto border-t border-brand-100 pt-4">
      <p class="truncate text-xs text-muted">{user?.email}</p>
      <form method="POST" action="/admin/logout">
        <button type="submit" class="mt-2 w-full rounded-lg bg-brand-100 px-3 py-2 text-sm font-semibold text-brand-900 hover:bg-brand-200">
          Cerrar sesión
        </button>
      </form>
    </div>
  </aside>

  <!-- Contenido principal -->
  <main class="flex-1 p-6 md:p-10">
    <header class="mb-8 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-brand-900 sm:text-3xl">{title}</h1>
      <a href="/" target="_blank" class="rounded-lg border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-800 hover:bg-brand-50">
        Ver web ↗
      </a>
    </header>
    <slot />
  </main>
</body>
</html>
