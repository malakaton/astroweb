{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.astro",
		"*.mjs",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	],
	"compilerOptions": {
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			],
			"@components/*": [
				"src/components/*"
			],
			"@layouts/*": [
				"src/layouts/*"
			],
			"@lib/*": [
				"src/lib/*"
			],
			"@config": [
				"src/config/site.ts"
			],
			"@assets/*": [
				"src/assets/*"
			]
		}
	}
}