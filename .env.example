# ══════════════════════════════════════════════════════════════════════════════
# Variables de entorno — Reformas Arana
# Copia como .env para desarrollo local.
# En Cloudflare Pages: Settings → Environment variables.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (obligatorias) ──────────────────────────────────────────────────
# URL del proyecto Supabase (Project Settings → API → URL)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Clave pública anon: usada por el loader en build time para leer el contenido.
# NO es secreta (solo lee contenido publicado gracias a las RLS).
SUPABASE_ANON_KEY="eyJ..."

# Clave service_role: usada por la Pages Function del formulario.
# MARCAR COMO SECRET en Cloudflare (encrypt). No la publiques nunca.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Formulario de contacto (opcionales) ──────────────────────────────────────
# Sal para el hash de IP (antiabuso sin almacenar datos personales)
IP_HASH_SALT="cadena-aleatoria-larga"

# Notificación por email cuando entra un lead (requiere cuenta en Resend)
NOTIFICATION_EMAIL="comercial@reformasarana.es"
RESEND_API_KEY=""
