# Variables de entorno del backend (Cloudflare Pages → Settings → Variables).
# NUNCA se exponen al navegador: solo las usa functions/api/contact.ts.
# Copia este archivo a .dev.vars para desarrollo local con `wrangler pages dev`.

# Supabase — obligatorias para que el formulario guarde los leads
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role_key_aqui__marcar_como_secret_en_cloudflare"

# Sal para el hash de IP (antiabuso sin almacenar datos personales en claro)
IP_HASH_SALT="cadena-aleatoria-larga"

# Aviso por email de cada nuevo lead (opcional)
NOTIFICATION_EMAIL="comercial@reformasarana.es"
RESEND_API_KEY=""
