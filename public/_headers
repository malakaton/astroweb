# Cabeceras HTTP para Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)
# Este archivo se copia tal cual a la raíz del despliegue.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  # El sitio no ejecuta JavaScript: script-src 'none' es la política más estricta
  # posible y además protege frente a inyecciones de terceros.
  # style-src permite 'unsafe-inline' porque Astro puede inlinear CSS crítico
  # (build.inlineStylesheets: 'auto') y por los estilos en línea de <svg>.
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Assets con hash en el nombre: cacheables para siempre
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800

# HTML: siempre revalidado contra el CDN para publicar cambios al instante
/*.html
  Cache-Control: public, max-age=0, must-revalidate
